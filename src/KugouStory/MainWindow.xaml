<Window x:Class="KugouStory.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="听见 · 酷狗歌曲故事" Width="420" Height="450" MinWidth="400" MinHeight="430"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ResizeMode="CanResizeWithGrip" Topmost="True" FontFamily="Microsoft YaHei UI"
 Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_KeyDown">
 <Border Margin="8" CornerRadius="18" BorderBrush="#3B4864" BorderThickness="1">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#17243A" Offset="0"/><GradientStop Color="#101624" Offset="1"/>
  </LinearGradientBrush></Border.Background>
  <Grid Margin="22,17,22,16">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="23"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <Grid Grid.Row="0" MouseLeftButtonDown="DragHeader" Background="Transparent">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#193B40" CornerRadius="7" Width="29" Height="29" Margin="0,0,9,0">
      <TextBlock Text="♫" FontSize="20" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <StackPanel><TextBlock Text="听见" FontSize="14" FontWeight="SemiBold"/>
      <TextBlock Text="每首歌，都有来处" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="PinButton" Content="取消置顶" Width="66" FontSize="10" Padding="0,6" Background="#193B40" Foreground="{StaticResource Accent}" Click="TogglePin" ToolTip="取消窗口置顶" AutomationProperties.Name="取消置顶"/>
     <Button x:Name="SettingsButton" Content="⚙" Width="28" Padding="0,6" Background="Transparent" Click="OpenSettings" ToolTip="设置 AI 接口与小窗外观" AutomationProperties.Name="设置"/>
     <Button x:Name="MinimizeButton" Content="−" Width="28" Padding="0,6" Background="Transparent" Click="HideToTray" ToolTip="最小化到系统托盘" AutomationProperties.Name="最小化到系统托盘"/>
     <Button x:Name="CloseButton" Content="×" Width="28" Padding="0,6" Background="Transparent" Click="ExitApp" ToolTip="关闭插件" AutomationProperties.Name="关闭插件"/>
    </StackPanel>
   </Grid>
   <StackPanel Grid.Row="2">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
     <Ellipse x:Name="StatusDot" Fill="{StaticResource Accent}" Width="5" Height="5" Margin="0,0,6,0"/>
     <TextBlock x:Name="PlaybackLabel" Text="等待酷狗播放" Foreground="{StaticResource Accent}" FontSize="10"/>
    </StackPanel>
    <TextBlock x:Name="SongTitle" Text="等一首歌的故事" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <TextBlock x:Name="SongArtist" Text="打开酷狗，播放你喜欢的歌" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
   <Border Grid.Row="4" Background="#111B2C" BorderBrush="#29354C" BorderThickness="1" CornerRadius="11" Padding="14,12">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><TextBlock Text="歌曲背后" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold"/>
      <TextBlock x:Name="CharCount" Text="100 字以内" FontSize="9" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,9,0,6">
      <TextBlock x:Name="StoryBody" Text="旋律响起时，故事会在这里展开。首次使用，请点击右上角设置，连接 DeepSeek。" TextWrapping="Wrap" FontSize="13" LineHeight="23" Foreground="#DCE5F5"/>
     </ScrollViewer>
     <TextBlock Grid.Row="2" x:Name="StoryMeta" Text="自动检索 · 对照原文 · 100 字以内" FontSize="9" Foreground="#7F91AD"/>
    </Grid>
   </Border>
   <Grid Grid.Row="6">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="FooterStatus" Text="自动识别 · 每 1.2 秒检查" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button x:Name="SourcesButton" Content="来源" IsEnabled="False" Padding="8,5" FontSize="10" Background="Transparent" Foreground="{StaticResource Muted}" Click="SearchSources" ToolTip="查看后台核对时使用的网页原文"/>
     <Button x:Name="RefreshButton" Content="重试" Padding="11,5" FontSize="10" Click="RefreshStory" ToolTip="重新检索资料并生成当前歌曲的介绍"/>
    </StackPanel>
   </Grid>
  </Grid>
 </Border>
</Window>
