<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>KugouStory</AssemblyName>
    <Version>1.1.2</Version>
    <Product>听见 · 酷狗歌曲故事</Product>
    <Description>自动识别酷狗歌曲，用100字以内讲述歌曲背后的故事</Description>
    <!-- WPF uses the manifest for DPI; WinForms is used only by the tray icon. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KugouStory.Core/KugouStory.Core.csproj" />
  </ItemGroup>
</Project>
