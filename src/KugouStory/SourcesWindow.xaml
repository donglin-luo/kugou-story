<Window x:Class="KugouStory.SourcesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="听见 · 故事来源" Width="510" Height="470" MinHeight="350" MinWidth="400"
 WindowStartupLocation="CenterOwner" Background="#121B2B" FontFamily="Microsoft YaHei UI">
 <Grid Margin="25">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="这段故事的来源" FontSize="21" FontWeight="SemiBold"/>
  <TextBlock Grid.Row="1" x:Name="Summary" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,9,0,17" LineHeight="19"/>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
   <ItemsControl x:Name="SourceList">
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="#1B263B" CornerRadius="9" Padding="14" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="{Binding Site}" Foreground="{StaticResource Accent}" FontSize="10" Margin="0,0,0,6"/>
       <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13" LineHeight="21"/>
       <TextBlock Text="{Binding QuotePreview}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" LineHeight="19" Margin="0,8,0,0"/>
       <Button Content="打开原文 ↗" Tag="{Binding Url}" Click="OpenSource" Background="Transparent" Foreground="{StaticResource Accent}" Padding="0,7,0,0" FontSize="11" HorizontalAlignment="Left"/>
      </StackPanel>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <Button Grid.Row="3" Content="关闭" HorizontalAlignment="Right" Padding="20,8" Margin="0,14,0,0" Click="CloseWindow"/>
 </Grid>
</Window>
