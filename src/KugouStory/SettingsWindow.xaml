<Window x:Class="KugouStory.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="听见 · AI 设置" Width="460" Height="600" MinHeight="520" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="#121B2B" Foreground="#EEF3FC" FontFamily="Microsoft YaHei UI"
 Closed="Window_Closed">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel Margin="28,24,28,26">
  <TextBlock Text="连接 DeepSeek" FontSize="23" FontWeight="SemiBold"/>
  <TextBlock Text="让每首歌，多一段故事。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,23"/>
  <TextBlock Text="API Key" FontSize="12" Margin="0,0,0,8"/>
  <PasswordBox x:Name="KeyInput" Background="#151D2E" Foreground="#EEF3FC" BorderBrush="#34415C" Padding="10" FontSize="14" CaretBrush="#6DE5CD" AutomationProperties.Name="DeepSeek API Key"/>
  <TextBlock Text="使用 Windows 加密，仅当前 Windows 账户可解密。" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,8,0,8"/>
  <Button Content="前往 DeepSeek 获取 API Key ↗" Click="OpenProvider" HorizontalAlignment="Left" Background="Transparent" Foreground="{StaticResource Accent}" Padding="0,4" FontSize="11"/>
  <TextBlock Text="模型名称" FontSize="12" Margin="0,18,0,8"/>
  <TextBox x:Name="ModelInput" AutomationProperties.Name="模型名称"/>
  <TextBlock Text="默认 deepseek-flash；可改为服务商支持的其他模型。" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
  <Expander Header="高级设置" Foreground="#B5C1D5" Margin="0,19,0,0" IsExpanded="False">
   <StackPanel Margin="0,10,0,0">
    <TextBlock Text="接口地址（兼容 Chat Completions）" FontSize="11" Margin="0,0,0,7"/>
    <TextBox x:Name="BaseUrlInput" AutomationProperties.Name="API 接口地址"/>
    <TextBlock Text="自动联网检索使用 DeepSeek 官方搜索接口，请保留 https://api.deepseek.com。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,9"/>
   </StackPanel>
  </Expander>
  <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
   <TextBlock Text="小窗不透明度" VerticalAlignment="Center" FontSize="12"/>
   <Slider Grid.Column="1" x:Name="OpacityInput" Minimum="0.65" Maximum="1" Value="0.97" TickFrequency="0.05" IsSnapToTickEnabled="False" VerticalAlignment="Center" AutomationProperties.Name="小窗不透明度"/>
  </Grid>
  <TextBlock Text="后台自动搜索并读取公开资料，再整理为100字以内的介绍并逐项核对。搜索、网页读取与AI调用按服务商规则计费。" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="18" Margin="0,18,0,0"/>
  <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="{StaticResource Accent}" FontSize="11" MinHeight="32" Margin="0,12,0,8"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="TestButton" Content="测试连接" HorizontalAlignment="Left" Click="TestConnection" FontSize="12"/>
   <Button Grid.Column="1" Content="取消" Margin="0,0,8,0" Click="Cancel" Background="Transparent" FontSize="12"/>
   <Button Grid.Column="2" Content="保存并应用" Click="Save" Background="#6DE5CD" Foreground="#112627" FontSize="12" FontWeight="SemiBold" IsDefault="True"/>
  </Grid>
 </StackPanel>
 </ScrollViewer>
</Window>
